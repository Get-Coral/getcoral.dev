---
import {
	DISCORD_URL,
	DOCS_URL,
	GITHUB_ORG_URL,
	SITE_NAME,
	SPONSORS_URL,
} from "../lib/site";
---
<footer class='site-footer'>
  <div class='footer-left'>
    <img class='nav-logo-mark' src='/logos/coral-mark.svg' alt='' aria-hidden='true' width='24' height='24' />
    <span class='footer-copy'>{SITE_NAME} — MIT licensed, built in the open.</span>
  </div>
  <div class='footer-links'>
    <a href='/apps' class='footer-link'>Modules</a>
    <a href='/compare' class='footer-link'>Comparisons</a>
    <a href='/guides/jellyfin-docker-compose-stack' class='footer-link'>Compose guide</a>
    <a href='/stats' class='footer-link'>Stats</a>
    <a href={DOCS_URL} class='footer-link'>Docs</a>
    <a href={GITHUB_ORG_URL} target='_blank' rel='noopener' class='footer-link'>GitHub</a>
    <a href={DISCORD_URL} target='_blank' rel='noopener' class='footer-link'>Discord</a>
    <a href={SPONSORS_URL} target='_blank' rel='noopener' class='footer-link'>Sponsor</a>
  </div>
</footer>
