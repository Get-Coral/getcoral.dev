---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import SiteFooter from "@components/SiteFooter.astro";
import SiteNav from "@components/SiteNav.astro";
import Layout from "@layouts/Default.astro";
import { breadcrumbNode } from "../lib/schema";
import { SITE_URL } from "../lib/site";
import {
	DOCKER_NAMESPACE,
	formatCount,
	getImageStats,
	getPackageStats,
	sumCounts,
} from "../lib/stats";

// Fetched at build time so the numbers are real text on the page rather than
// pixels inside a remote SVG.
const [packages, images] = await Promise.all([
	getPackageStats(),
	getImageStats(),
]);

const totalDownloads = sumCounts(packages.map((p) => p.weeklyDownloads));
const totalPulls = sumCounts(images.map((i) => i.pulls));
const buildDate = new Date().toISOString().slice(0, 10);

const url = `${SITE_URL}/stats`;
const description = `Coral ecosystem usage: ${formatCount(totalPulls)} Docker pulls across ${images.length} module images and ${formatCount(totalDownloads)} weekly npm downloads across ${packages.length} packages.`;

const schemaNodes = [
	breadcrumbNode(url, [
		{ name: "Home", url: `${SITE_URL}/` },
		{ name: "Stats", url },
	]),
];
---

<Layout
	title='Coral stats — npm downloads and Docker pulls'
	description={description.slice(0, 155)}
	schemaNodes={schemaNodes}
	breadcrumbId={`${url}#breadcrumb`}
	dateModified={buildDate}
>
	<SiteNav />

	<main id='main' class='stats-page'>
		<section class='stats-hero'>
			<Breadcrumbs trail={[{ name: "Home", url: "/" }, { name: "Stats", url: "/stats" }]} />
			<h1>Coral ecosystem stats</h1>
			<p class='stats-sub'>
				Public usage numbers for the Coral modules and packages, pulled from the Docker Hub and
				npm registry APIs when this page was built on {buildDate}. Every Coral module is MIT
				licensed and ships as a Docker image, so pull counts are the closest thing to an install
				count that exists.
			</p>
			<div class='stats-chips'>
				<span class='chip'>{formatCount(totalPulls)} Docker pulls</span>
				<span class='chip'>{formatCount(totalDownloads)} weekly npm downloads</span>
				<span class='chip'>{packages.length} npm packages</span>
				<span class='chip'>{images.length} Docker images</span>
			</div>
		</section>

		<section class='stats-grid'>
			<article class='stats-card reveal visible'>
				<h2>Docker pulls</h2>
				<p class='card-sub'>
					Total pulls per module image from Docker Hub, newest activity first.
				</p>
				<table class='spec-table' style='margin-top: 1rem;'>
					<thead>
						<tr><th>Module</th><th>Pulls</th><th>Last updated</th></tr>
					</thead>
					<tbody>
						{images.map((image) => (
							<tr>
								<th scope='row'>
									<a
										href={`https://hub.docker.com/r/${DOCKER_NAMESPACE}/${image.name}`}
										target='_blank'
										rel='noopener'
										class='card-link'
									>{DOCKER_NAMESPACE}/{image.name}</a>
								</th>
								<td>{formatCount(image.pulls)}</td>
								<td>{image.lastUpdated ?? "—"}</td>
							</tr>
						))}
						<tr>
							<th scope='row'>Total</th>
							<td>{formatCount(totalPulls)}</td>
							<td>&nbsp;</td>
						</tr>
					</tbody>
				</table>
			</article>

			<article class='stats-card reveal visible'>
				<h2>npm downloads</h2>
				<p class='card-sub'>Downloads in the last seven days for each published package.</p>
				<table class='spec-table' style='margin-top: 1rem;'>
					<thead>
						<tr><th>Package</th><th>Weekly downloads</th><th>Source</th></tr>
					</thead>
					<tbody>
						{packages.map((pkg) => (
							<tr>
								<th scope='row'>
									<a
										href={`https://www.npmjs.com/package/${pkg.name}`}
										target='_blank'
										rel='noopener'
										class='card-link'
									>{pkg.name}</a>
								</th>
								<td>{formatCount(pkg.weeklyDownloads)}</td>
								<td>
									<a href={pkg.repo} target='_blank' rel='noopener' class='card-link'>repo</a>
								</td>
							</tr>
						))}
						<tr>
							<th scope='row'>Total</th>
							<td>{formatCount(totalDownloads)}</td>
							<td>&nbsp;</td>
						</tr>
					</tbody>
				</table>
			</article>
		</section>

		<section class='stats-hero' style='padding-top: 0;'>
			<p class='stats-sub'>
				Want to add to them? Start with the <a href='/apps' class='card-link'>module list</a> or the
				<a href='/guides/jellyfin-docker-compose-stack' class='card-link'>Docker Compose stack guide</a>.
			</p>
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
  .stats-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 7rem 1.25rem 3rem;
  }

  .stats-hero {
    border: 1px solid var(--border);
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.05),
      rgba(45, 212, 191, 0.04)
    );
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .hero-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }

  .stats-hero h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    margin-bottom: 0.6rem;
  }

  .stats-hero p {
    color: var(--ink-muted);
    max-width: 70ch;
  }

  .hero-chips {
    margin-top: 1rem;
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.8rem;
    color: var(--ink);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .stats-card {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 18px;
    padding: 1.25rem;
  }

  .stats-card h2 {
    font-size: 1.35rem;
    margin-bottom: 0.3rem;
  }

  .card-sub {
    color: var(--ink-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .metric-list {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .metric-item {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.75rem;
    display: grid;
    gap: 0.5rem;
  }

  .metric-item-link {
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .metric-item-link:hover {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-1px);
  }

  .metric-item-link:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }

  .metric-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .metric-name {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    text-transform: capitalize;
  }

  .metric-link {
    color: var(--teal);
    text-decoration: none;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .metric-item img {
    max-width: 100%;
    height: 20px;
  }

  .stats-note {
    margin-top: 1rem;
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 1rem;
    color: var(--ink-muted);
    background: rgba(255, 255, 255, 0.02);
  }

  .stats-note h3 {
    color: var(--ink);
    margin-bottom: 0.45rem;
    font-size: 1.05rem;
  }

  .stats-note p + p {
    margin-top: 0.4rem;
  }
</style>
