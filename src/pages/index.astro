---
import { getCollection } from "astro:content";
import AgentContext from "@components/AgentContext.astro";
import Icons from "@components/Icons.astro";
import SiteFooter from "@components/SiteFooter.astro";
import SiteNav from "@components/SiteNav.astro";
import Layout from "@layouts/Default.astro";
import { itemListNode } from "../lib/schema";
import {
	DISCORD_URL,
	DOCS_URL,
	GITHUB_ORG_URL,
	SITE_URL,
	SPONSORS_URL,
} from "../lib/site";

const modules = (await getCollection("modules")).sort(
	(a, b) => a.data.order - b.data.order,
);

const url = `${SITE_URL}/`;
const schemaNodes = [
	itemListNode(
		url,
		modules.map((m) => ({
			name: m.data.name,
			url: `${SITE_URL}/apps/${m.id}`,
			description: m.data.tagline,
		})),
	),
];
---

<Layout
  title='Coral — open-source Jellyfin modules'
  description='Coral is an open-source Jellyfin ecosystem: seven independent, Docker-native modules for playback, karaoke, torrents, reading, displays and cleanup.'
  schemaNodes={schemaNodes}
>
  <SiteNav />

  <main id='main'>
  <!-- HERO -->
  <section class='hero'>
    <div class='glow-coral' style='top: -150px; left: -150px;'></div>
    <div class='glow-teal' style='bottom: -100px; right: -100px;'></div>

    <div class='hero-inner'>
      <div class='animate-fade-up delay-1 hero-badge'>
        <span>🪸</span> Open Source Jellyfin Ecosystem
      </div>

      <h1 class='animate-fade-up delay-2 hero-title'>
        Open-source Jellyfin modules.<br />
        Your media server, <em>reimagined.</em>
      </h1>

      <p class='animate-fade-up delay-3 hero-sub'>
        Coral is a reef of seven independent, Docker-native modules that extend
        Jellyfin: cinematic playback, karaoke, torrents, a reading room, ambient
        displays and library cleanup. Each runs on its own, reads your Jellyfin
        server as the source of truth, and is MIT licensed.
      </p>

      <div class='animate-fade-up delay-4 hero-ctas'>
        <a href='/apps' class='btn-primary'>Explore all 7 modules</a>
        <a href='/guides/jellyfin-docker-compose-stack' class='btn-ghost'>Docker Compose guide</a>
        <a
          href='https://docs.getcoral.dev/getting-started/create-coral/'
          class='btn-ghost'>Scaffold with the CLI</a
        >
        <a
          href='https://docs.getcoral.dev/libraries/coral-ui/'
          class='btn-ghost'>Explore Coral UI</a
        >
        <a
          href={GITHUB_ORG_URL}
          target='_blank'
          class='btn-ghost'
        >
          <Icons name='github' />
          View on GitHub
        </a>
      </div>

      <div class='animate-fade-up delay-5 stats-row'>
        <div class='stat'>
          <div class='stat-value' style='color: var(--coral);'>7</div>
          <div class='stat-label'>Modules</div>
        </div>
        <div class='stat-divider'></div>
        <div class='stat'>
          <div class='stat-value' style='color: var(--teal);'>MIT</div>
          <div class='stat-label'>Licensed</div>
        </div>
        <div class='stat-divider'></div>
        <div class='stat'>
          <div class='stat-value'>∞</div>
          <div class='stat-label'>No quotas</div>
        </div>
        <div class='stat-divider'></div>
        <div class='stat'>
          <div class='stat-value' style='color: var(--teal);'>CLI</div>
          <div class='stat-label'>create-coral</div>
        </div>
        <div class='stat-divider'></div>
        <div class='stat'>
          <div class='stat-value' style='color: var(--coral);'>5</div>
          <div class='stat-label'>NPM packages</div>
        </div>
        <div class='stat-divider'></div>
        <div class='stat'>
          <div class='stat-value'>🐳</div>
          <div class='stat-label'>Docker native</div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section id='modules' class='section-modules'>
    <div class='reveal section-header'>
      <p class='section-eyebrow' style='color: var(--teal);'>The Reef</p>
      <h2 class='section-title'>
        Every module is independent.<br /><span class='section-title-muted'
          >Together they're an ecosystem.</span
        >
      </h2>
      <p class='section-sub'>
        Each one runs as a Docker container, talks to your Jellyfin server, and
        does one thing brilliantly.
      </p>
    </div>

    <div class='modules-grid'>
      {
        modules.map((mod, i) => (
          <div
            class={`module-card ${mod.data.accent}-accent reveal`}
            style={`animation-delay: ${i * 0.07}s`}
          >
            <div class='card-header'>
              {
                mod.data.logo ? (
                  <img class='card-logo' src={mod.data.logo} alt='' aria-hidden='true' />
                ) : (
                  <span class='card-emoji'>{mod.data.emoji}</span>
                )
              }
            </div>
            <h3 class='card-title'>
              <a href={`/apps/${mod.id}`} class='module-card-link'>{mod.data.name}</a>
            </h3>
            <p class='card-tagline'>{mod.data.tagline}</p>
            <p class='card-desc'>{mod.data.description}</p>
            <div class='card-actions'>
              <a href={`/apps/${mod.id}`} class='card-link'>
                {mod.data.name} for Jellyfin
              </a>
              <a href={mod.data.repo} target='_blank' rel='noopener' class='card-link'>
                <Icons name='github' />
                View repo
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PACKAGES -->
  <section class='section-philosophy'>
    <div class='section-inner'>
      <div class='reveal section-header'>
        <p class='section-eyebrow' style='color: var(--teal);'>
          Shared Packages
        </p>
        <h2 class='section-title'>Build once, reuse everywhere.</h2>
        <p class='section-sub'>
          Coral also ships reusable NPM packages so modules can share UI, typed
          APIs, and tooling standards. Scaffold your own module with <code>pnpm
          create coral@latest</code> and reuse components from <code>@get-coral/ui</code>.
        </p>
      </div>

      <div class='principles-grid'>
        <div class='reveal principle-card'>
          <div class='principle-icon'>🧩</div>
          <h3 class='principle-title'>@get-coral/ui</h3>
          <p class='principle-body'>
            Shared React component library and design tokens for consistent
            Coral interfaces.
          </p>
          <a
            href='https://docs.getcoral.dev/libraries/coral-ui/'
            class='card-link'
          >
            Read docs
          </a>
        </div>

        <div class='reveal principle-card'>
          <div class='principle-icon'>🔌</div>
          <h3 class='principle-title'>@get-coral/jellyfin</h3>
          <p class='principle-body'>
            Typed Jellyfin API client used across Coral modules and custom apps.
          </p>
          <a
            href='https://docs.getcoral.dev/libraries/jellyfin/'
            class='card-link'
          >
            Read docs
          </a>
        </div>

        <div class='reveal principle-card'>
          <div class='principle-icon'>🛠️</div>
          <h3 class='principle-title'>Developer Standards</h3>
          <p class='principle-body'>
            Shared TypeScript and Biome presets keep all Coral repos aligned.
          </p>
          <a
            href='https://docs.getcoral.dev/libraries/npm-packages/'
            class='card-link'
          >
            View package catalog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section id='principles' class='section-philosophy'>
    <div class='section-inner'>
      <div class='reveal section-header'>
        <p class='section-eyebrow' style='color: var(--coral);'>Philosophy</p>
        <h2 class='section-title'>Built on three rules.</h2>
      </div>

      <div class='principles-grid'>
        {
          [
            {
              icon: '🐳',
              title: 'Docker native',
              body: 'Every module ships as a Docker image. One Compose file, one command, running on your NAS. No cloud dependency, no internet required at the bar.',
            },
            {
              icon: '🪸',
              title: 'Jellyfin as source of truth',
              body: 'Modules never share a database. What Jellyfin knows, you read from Jellyfin; for the few things it has no API for, modules expose small versioned contracts you opt into. Every module still runs alone.',
            },
            {
              icon: '🔓',
              title: 'MIT forever',
              body: 'Open source, no paid tier, no SaaS. GitHub Sponsors if you get value from it. The code belongs to everyone.',
            },
          ].map((p) => (
            <div class='reveal principle-card'>
              <div class='principle-icon'>{p.icon}</div>
              <h3 class='principle-title'>{p.title}</h3>
              <p class='principle-body'>{p.body}</p>
            </div>
          ))
        }
      </div>

      <div class='reveal code-block'>
        <p class='code-label'>docker-compose.yml</p>
        <pre
          class='code-pre'><span style="color: var(--teal);">services:</span>
  <span style="color: var(--coral);">aurora:</span>
    <span style="color: var(--ink-muted);">image: getcoral/aurora:latest</span>
    <span style="color: var(--ink-muted);">ports: ["3000:3000"]</span>
    <span style="color: var(--ink-muted);">environment:</span>
    <span style="color: var(--ink-faint);">  JELLYFIN_URL: http://jellyfin:8096</span>
    <span style="color: var(--ink-faint);">  JELLYFIN_API_KEY: {'${JELLYFIN_API_KEY}'}</span>
    <span style="color: var(--ink-muted);">volumes: ["./aurora-data:/data"]</span></pre>
        <p class='section-sub' style='margin-top: 1rem;'>
          <a href='/guides/jellyfin-docker-compose-stack' class='card-link'
            >The full stack — Jellyfin, Aurora, Tide and Librarian in one file</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class='section-sponsor' id='community'>
    <div class='reveal sponsor-inner'>
      <div class='sponsor-icon'>🪸</div>
      <h2 class='sponsor-title'>Join the reef.</h2>
      <p class='sponsor-body'>
        Got a question? Found a bug? Want to share your setup or request a
        feature? The Coral Discord is where it all happens — support, ideas, and
        the people building on the reef.
      </p>
      <div class='sponsor-ctas'>
        <a
          href={DISCORD_URL}
          target='_blank'
          class='btn-primary'>🪸 Join Discord</a
        >
        <a href={DOCS_URL} target='_blank' rel='noopener' class='btn-ghost'
          >Read the docs</a
        >
      </div>
    </div>
  </section>

  <!-- ORIGIN STORY -->
  <section class='section-origin'>
    <div class='reveal origin-inner'>
      <h2 class='section-eyebrow' style='color: var(--ink-faint);'>
        How Coral started
      </h2>
      <blockquote class='origin-quote'>
        "Built because a superhero-themed bar in Ghent was still using coasters
        to manage their karaoke queue."
      </blockquote>
      <p class='origin-sub'>
        KAPOW! was the first module — made for Comic Sans bar. Coral grew from
        there.
      </p>
    </div>
  </section>

  <!-- SPONSOR CTA -->
  <section class='section-sponsor'>
    <div class='reveal sponsor-inner'>
      <div class='sponsor-icon'>🪸</div>
      <h2 class='sponsor-title'>Support the reef.</h2>
      <p class='sponsor-body'>
        Coral is free, open source, and built solo. If it runs on your NAS and
        makes your life better — consider sponsoring. Every bit keeps the
        modules maintained and growing.
      </p>
      <div class='sponsor-ctas'>
        <a
          href={SPONSORS_URL}
          target='_blank'
          class='btn-primary'>❤️ Sponsor on GitHub</a
        >
        <a href={GITHUB_ORG_URL} target='_blank' rel='noopener' class='btn-ghost'
          >Star a repo</a
        >
        <a
          href={DISCORD_URL}
          target='_blank'
          class='btn-ghost'>Join Discord</a
        >
      </div>
    </div>
  </section>

  </main>

  <SiteFooter />
  <AgentContext />
</Layout>
