---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Faq from "@components/Faq.astro";
import SiteFooter from "@components/SiteFooter.astro";
import SiteNav from "@components/SiteNav.astro";
import Layout from "@layouts/Default.astro";
import {
	breadcrumbNode,
	faqNode,
	softwareApplicationNode,
} from "../../lib/schema";
import { SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
	const modules = await getCollection("modules");
	return modules.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, all: modules },
	}));
}

type Props = {
	entry: CollectionEntry<"modules">;
	all: CollectionEntry<"modules">[];
};

const { entry, all } = Astro.props;
const module = entry.data;
const { Content } = await render(entry);

const url = `${SITE_URL}/apps/${entry.id}`;
const related = module.related
	.map((slug) => all.find((m) => m.id === slug))
	.filter((m): m is CollectionEntry<"modules"> => Boolean(m));

const breadcrumb = breadcrumbNode(url, [
	{ name: "Home", url: `${SITE_URL}/` },
	{ name: "Modules", url: `${SITE_URL}/apps` },
	{ name: module.name, url },
]);

const schemaNodes = [
	softwareApplicationNode({ slug: entry.id, ...module }),
	breadcrumb,
	...(module.faq.length ? [faqNode(url, module.faq)] : []),
];
---

<Layout
	title={module.seoTitle}
	description={module.seoDescription}
	image={`/apps/${entry.id}/og.png`}
	imageAlt={`${module.name} — ${module.tagline}`}
	schemaNodes={schemaNodes}
	breadcrumbId={`${url}#breadcrumb`}
	dateModified={module.dateModified}
>
	<SiteNav />

	<main id="main">
		<section class={`app-hero ${module.accent}-accent`}>
			<div class="glow-coral" style="top: -180px; left: -140px;"></div>
			<div class="glow-teal" style="bottom: -140px; right: -120px;"></div>

			<div class="app-shell">
				<Breadcrumbs
					trail={[
						{ name: "Home", url: "/" },
						{ name: "Modules", url: "/apps" },
						{ name: module.name, url: `/apps/${entry.id}` },
					]}
				/>
				<div class="app-hero-copy reveal visible">
					<div class="app-badge-row">
						<p class="hero-badge">
							{module.logo ? (
								<img class='badge-logo' src={module.logo} alt='' aria-hidden='true' />
							) : (
								<span>{module.emoji}</span>
							)}
							{module.name}
						</p>
						<span class={`badge badge-${module.status}`}>
							<span class="badge-dot" />
							{module.statusLabel}
						</span>
						{module.version && (
							<span class="badge">v{module.version}</span>
						)}
					</div>

					<h1 class="app-title">
						{module.name}
						<span class="app-title-muted">{module.tagline}</span>
					</h1>

					<p class="answer-block" style="margin-top: 1.4rem; max-width: 62ch;">
						{module.answer}
					</p>

					<div class="hero-ctas">
						<a href="#install-with-docker-compose" class="btn-primary">Install with Docker</a>
						<a href={module.docs} class="btn-ghost">Read documentation</a>
						<a href={module.repo} target="_blank" rel="noopener" class="btn-ghost">View repository</a>
						{module.containerUrl && (
							<a href={module.containerUrl} target="_blank" rel="noopener" class="btn-ghost">Docker Hub</a>
						)}
					</div>
				</div>
			</div>
		</section>

		<section class="app-section">
			<div class="app-shell app-grid">
				<div class="app-panel reveal">
					<p class="section-eyebrow" style={`color: var(--${module.accent});`}>Features</p>
					<h2 class="section-title">What {module.name} does</h2>
					<ul class="app-list" style="list-style: none; padding: 0;">
						{module.highlights.map((item) => (
							<li class="app-list-item">
								<div class="app-list-dot"></div>
								<p>{item}</p>
							</li>
						))}
					</ul>
				</div>

				<div class="app-panel reveal">
					<p class="section-eyebrow" style={`color: var(--${module.accent});`}>Audience</p>
					<h2 class="section-title">Who {module.name} is for</h2>
					<ul class="app-chip-grid" style="list-style: none; padding: 0;">
						{module.bestFor.map((item) => (
							<li class="app-chip">{item}</li>
						))}
					</ul>

					{module.requirements.length > 0 && (
						<>
							<h3 style="margin-top: 1.8rem; color: var(--ink); font-weight: 600;">Requirements</h3>
							<ul class="app-list" style="list-style: none; padding: 0; margin-top: 0.8rem;">
								{module.requirements.map((item) => (
									<li class="app-list-item">
										<div class="app-list-dot"></div>
										<p>{item}</p>
									</li>
								))}
							</ul>
						</>
					)}
				</div>
			</div>
		</section>

		<section class="app-section app-section-border">
			<div class="app-shell">
				<div class="prose">
					<Content />
				</div>
			</div>
		</section>

		{module.envVars.length > 0 && (
			<section class="app-section app-section-border">
				<div class="app-shell">
					<h2 class="section-title" id="configuration">Configuring {module.name}</h2>
					<p class="section-sub" style="margin-top: 0.8rem;">
						The full reference lives in the <a href={module.docs} class="card-link">{module.name} documentation</a>.
					</p>
					<table class="spec-table" style="margin-top: 1.4rem;">
						<thead>
							<tr><th>Variable</th><th>Purpose</th></tr>
						</thead>
						<tbody>
							{module.envVars.map((env) => (
								<tr>
									<td><code>{env.name}</code>{env.required && <> <span class="req-flag">required</span></>}</td>
									<td>{env.description}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		)}

		<Faq items={module.faq} heading={`${module.name} — frequently asked questions`} />

		{related.length > 0 && (
			<section class="app-section app-section-border">
				<div class="app-shell">
					<h2 class="section-title">Related Coral modules</h2>
					<div class="related-grid" style="margin-top: 1.4rem;">
						{related.map((other) => (
							<a href={`/apps/${other.id}`} class="related-card">
								<h3>{other.data.name}</h3>
								<p>{other.data.tagline}</p>
							</a>
						))}
					</div>
					<p style="margin-top: 1.4rem;">
						<a href="/apps" class="card-link">Browse all seven Coral modules for Jellyfin</a>
					</p>
				</div>
			</section>
		)}
	</main>

	<SiteFooter />
</Layout>
